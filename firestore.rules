rules_version = '2';

// Security rules for SetLog.
//
// Paste these into Firebase console → Firestore Database → Rules → Publish.
// They are kept in the repo so the rules the app needs are reviewable
// alongside the queries that depend on them.
//
// Every read and write is restricted to the document's owner, so one user
// can never see or change another user's sessions, sets or exercises.
// Firestore evaluates rules against a *query*, not against the documents it
// would return, so every query in FirestoreService filters on user_id —
// otherwise Firestore would reject it.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The document being written belongs to the caller.
    function ownsIncoming() {
      return signedIn() && request.auth.uid == request.resource.data.user_id;
    }

    // The document already stored belongs to the caller.
    function ownsExisting() {
      return signedIn() && request.auth.uid == resource.data.user_id;
    }

    // Updates must stay owned by the same user (no handing a document to
    // someone else by rewriting user_id).
    function updatesOwn() {
      return ownsExisting() && ownsIncoming();
    }

    // Workout sessions.
    match /sessions/{sessionId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if updatesOwn();
      allow delete: if ownsExisting();
    }

    // Logged sets — a top-level collection, not a subcollection, so that one
    // exercise can be queried across every session for the PB history.
    match /sets/{setId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if updatesOwn();
      allow delete: if ownsExisting();
    }

    // Exercise catalogue. The seeder stamps the signed-in uid on each row it
    // writes, and custom exercises added from the Library get the same.
    match /exercises/{exerciseId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if updatesOwn();
      allow delete: if ownsExisting();
    }

    // Anything not matched above is denied.
  }
}
